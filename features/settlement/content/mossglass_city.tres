[gd_resource type="Resource" script_class="CityDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://features/settlement/data/city_definition.gd" id="1_city"]
[ext_resource type="Script" path="res://features/settlement/data/city_district_definition.gd" id="2_district"]

[sub_resource type="Resource" id="HarborWard"]
script = ExtResource("2_district")
district_id = &"harbor_ward"
display_name = "Harbor Ward"
scene_path = "res://features/settlement/city/districts/mossglass_harbor_district.tscn"
map_coordinate = Vector2i(0, 1)
neighbor_ids = Array[StringName]([&"market_crown"])
entry_cell = Vector2i(20, 56)

[sub_resource type="Resource" id="MarketCrown"]
script = ExtResource("2_district")
district_id = &"market_crown"
display_name = "Market Crown"
scene_path = "res://features/settlement/city/districts/mossglass_market_district.tscn"
map_coordinate = Vector2i(1, 1)
neighbor_ids = Array[StringName]([&"harbor_ward", &"garden_heights"])
entry_cell = Vector2i(60, 56)

[sub_resource type="Resource" id="GardenHeights"]
script = ExtResource("2_district")
district_id = &"garden_heights"
display_name = "Garden Heights"
scene_path = "res://features/settlement/city/districts/mossglass_garden_district.tscn"
map_coordinate = Vector2i(2, 1)
neighbor_ids = Array[StringName]([&"market_crown"])
entry_cell = Vector2i(104, 56)

[resource]
script = ExtResource("1_city")
city_id = &"mossglass_city"
display_name = "Mossglass City"
districts = Array[ExtResource("2_district")]([SubResource("HarborWard"), SubResource("MarketCrown"), SubResource("GardenHeights")])
