; Engine configuration file.
; Prefer editing through the Godot editor when possible.

config_version=5

[application]

config/name="Creature Trail"
run/main_scene="res://features/adventure/adventure.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

EventHub="*res://autoload/event_hub.gd"
ContentRegistry="*res://autoload/content_registry.tscn"
GameSession="*res://autoload/game_session.gd"
SettingsService="*res://autoload/settings_service.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.2,
